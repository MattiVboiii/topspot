# App public URL (no trailing slash)
# Local:  http://127.0.0.1:3000
# Prod:   https://your-domain.vercel.app  (or custom domain)
NEXT_PUBLIC_APP_URL=http://127.0.0.1:3000

# Spotify Developer App (https://developer.spotify.com/dashboard)
# Register BOTH redirect URIs on the Spotify app:
#   http://127.0.0.1:3000/api/auth/spotify/callback
#   https://YOUR_PRODUCTION_DOMAIN/api/auth/spotify/callback
# Spotify rejects "localhost" — use 127.0.0.1 for local.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REDIRECT_URI=http://127.0.0.1:3000/api/auth/spotify/callback

# Signed host session cookie (openssl rand -base64 48)
SESSION_SECRET=generate-a-long-random-string-at-least-32-chars

# Firebase web client (Project settings > General > Your apps)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Firebase Admin (Project settings > Service accounts > Generate new private key)
# Paste the JSON fields below. For PRIVATE_KEY, keep \n escapes as a single line.
FIREBASE_ADMIN_PROJECT_ID=
FIREBASE_ADMIN_CLIENT_EMAIL=
FIREBASE_ADMIN_PRIVATE_KEY=

# Protects /api/cron/cleanup-parties
# On Vercel: set this env var; Cron Jobs send Authorization: Bearer <CRON_SECRET>
CRON_SECRET=
